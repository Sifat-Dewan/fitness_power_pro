# Copy to .env on the gym PC. Never commit this file.
SITE_URL="https://your-fitness-power-domain.vercel.app"
K40_AGENT_TOKEN="REPLACE_WITH_LONG_RANDOM_SECRET_USED_IN_VERCEL"
K40_DEVICE_ID="gym-k40-01"
K40_IP="192.168.0.123"
K40_PORT="4370"
K40_PASSWORD="0"
SYNC_SECONDS="120"
POLL_SECONDS="15"
# Safe default: no physical member deletion until backups and test succeed.
ENABLE_K40_DELETIONS="false"
